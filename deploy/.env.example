# Copy to deploy/.env, then use: docker compose --env-file deploy/.env -f deploy/compose.yaml up -d
ATLAS_PORT=18088
# Exact browser origins, comma separated, without trailing slashes.
ALLOWED_ORIGINS=http://localhost:18088
# Leave empty unless your tunnel rewrites Origin; see docs/deployment.md.
REWRITTEN_ORIGINS=
# Use true only when users access the application exclusively through HTTPS.
COOKIE_SECURE=false
